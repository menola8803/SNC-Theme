<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:format12Hour="HH"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="@color/snc_white"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:fontFamily="@font/cinzel"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="@color/snc_gold"
            android:textSize="58sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="@color/snc_white"
            android:textSize="64sp" />
    </LinearLayout>

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/cinzel"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:letterSpacing="0.15"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textAllCaps="true"
        android:textColor="@color/snc_gold_light"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="96dp"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/company"
        android:scaleType="fitStart"
        android:src="@drawable/logo_mono" />
</LinearLayout>
